{
  "linksChecked": "2026-11-03",
  "intro": "AI can copy your voice, learn from what you share and act on your behalf. A few questions show where that leaves you and what to change first.",

  "areas": [
    {"id": "family", "name": "People close to you"},
    {"id": "likeness", "name": "Your voice and face"},
    {"id": "ai_data", "name": "What you tell AI"},
    {"id": "ai_agents", "name": "AI acting for you"},
    {"id": "work", "name": "Your work"},
    {"id": "decisions", "name": "Decisions about you"},
    {"id": "response", "name": "If something happens"}
  ],

  "steps": [
    {"id": "safe_word", "area": "family", "title": "Agree a family safe word",
     "minutes": 10, "impact": 3, "tier": 1, "checkMethod": "self", "withOthers": true},
    {"id": "callback_rule", "area": "family", "title": "Agree a callback rule for money requests",
     "minutes": 5, "impact": 3, "tier": 1, "checkMethod": "self", "withOthers": true},
    {"id": "brief_relatives", "area": "family", "title": "Brief older relatives",
     "minutes": 30, "impact": 2, "tier": 2, "checkMethod": "self", "withOthers": true},
    {"id": "teen_controls", "area": "family", "title": "Set up teen controls on the chatbots they use",
     "minutes": 15, "impact": 2, "tier": 1, "checkMethod": "link",
     "links": [{"label": "ChatGPT parental controls", "url": "https://help.openai.com/en/articles/12315553"}, {"label": "Snapchat My AI", "url": "https://help.snapchat.com/hc/en-us/articles/22628526282772"}, {"label": "Gemini in Family Link", "url": "https://support.google.com/gemini/answer/16109150"}]},
    {"id": "teen_talk", "area": "family", "title": "Talk with them about AI companions",
     "minutes": 20, "impact": 2, "tier": 2, "checkMethod": "self", "withOthers": true,
     "links": [{"label": "Common Sense guide", "url": "https://www.commonsensemedia.org/articles/parents-ultimate-guide-to-ai-companions-and-relationships"}]},
    {"id": "bank_voice_id_off", "area": "likeness", "title": "Ask your bank to switch off voice ID",
     "minutes": 15, "impact": 3, "tier": 1, "checkMethod": "self", "withOthers": true},
    {"id": "voicemail_greeting", "area": "likeness", "title": "Switch your voicemail greeting to the default",
     "minutes": 2, "impact": 1, "tier": 2, "checkMethod": "self"},
    {"id": "voice_inventory", "area": "likeness", "title": "List where your voice is public",
     "minutes": 15, "impact": 1, "tier": 2, "checkMethod": "self"},
    {"id": "voice_audience", "area": "likeness", "title": "Limit who sees videos with your voice",
     "minutes": 30, "impact": 2, "tier": 2, "checkMethod": "self"},
    {"id": "youtube_likeness", "area": "likeness", "title": "Turn on YouTube likeness detection",
     "minutes": 15, "impact": 2, "tier": 3, "checkMethod": "auto",
