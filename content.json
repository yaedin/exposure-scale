     "links": [{"label": "Copilot", "url": "https://copilot.microsoft.com"}]},
    {"id": "meta_ai_settings", "area": "ai_data", "title": "Check Meta AI training settings",
     "minutes": 5, "impact": 1, "tier": 2, "checkMethod": "link",
     "links": [{"label": "Meta Privacy Center", "url": "https://www.facebook.com/privacy/center/"}]},
    {"id": "training_off_linkedin", "area": "ai_data", "title": "Turn off LinkedIn AI training",
     "minutes": 2, "impact": 1, "tier": 1, "checkMethod": "link",
     "links": [{"label": "LinkedIn setting", "url": "https://www.linkedin.com/mypreferences/d/settings/data-for-ai-improvement"}]},
    {"id": "training_off_github", "area": "ai_data", "title": "Turn off GitHub Copilot training",
     "minutes": 2, "impact": 1, "tier": 2, "checkMethod": "link",
     "links": [{"label": "Copilot settings", "url": "https://github.com/settings/copilot"}]},
    {"id": "training_off_x", "area": "ai_data", "title": "Turn off Grok training on X",
     "minutes": 2, "impact": 1, "tier": 1, "checkMethod": "link",
     "links": [{"label": "X Grok setting", "url": "https://x.com/settings/grok_settings"}]},
    {"id": "assistant_memory", "area": "ai_data", "title": "Review what your assistants remember",
     "minutes": 10, "impact": 1, "tier": 2, "checkMethod": "self"},
    {"id": "push_back", "area": "ai_data", "title": "Tell your assistant to argue the other side",
     "minutes": 5, "impact": 2, "tier": 1, "checkMethod": "link",
     "links": [{"label": "ChatGPT personalization", "url": "https://chatgpt.com/#settings/Personalization"}, {"label": "Claude preferences", "url": "https://claude.ai/settings/profile"}]},
    {"id": "agent_inventory", "area": "ai_agents", "title": "List what each agent can reach",
     "minutes": 10, "impact": 2, "tier": 1, "checkMethod": "self",
     "agentHelp": "The skill reads what Claude Code, Codex, Gemini CLI or Cursor can reach on this computer and goes through it with you."},
    {"id": "agent_confirm", "area": "ai_agents", "title": "Require a confirm before agents send or pay",
     "minutes": 5, "impact": 3, "tier": 1, "checkMethod": "self",
     "agentHelp": "The skill flags agents on this computer that skip approval prompts or have long allow lists."},
    {"id": "agent_revoke", "area": "ai_agents", "title": "Revoke agent connections you don’t use",
     "minutes": 10, "impact": 2, "tier": 2, "checkMethod": "link",
     "links": [{"label": "Google connections", "url": "https://myaccount.google.com/connections"}, {"label": "Microsoft app access", "url": "https://account.live.com/consent/Manage"}]},
    {"id": "agent_banking", "area": "ai_agents", "title": "Keep agents out of banking sessions",
     "minutes": 5, "impact": 2, "tier": 2, "checkMethod": "self"},
    {"id": "art_optout", "area": "work", "title": "Opt your art and photos out of AI training",
     "minutes": 15, "impact": 1, "tier": 2, "checkMethod": "link",
     "links": [{"label": "Adobe privacy", "url": "https://account.adobe.com/privacy"}, {"label": "DeviantArt opt-out", "url": "https://www.deviantart.com/team/journal/A-New-Standard-for-Opting-Out-of-AI-Datasets-934500371"}]},
    {"id": "block_ai_crawlers", "area": "work", "title": "Block AI crawlers on your website",
     "minutes": 15, "impact": 2, "tier": 2, "checkMethod": "auto",
     "links": [{"label": "Squarespace", "url": "https://support.squarespace.com/hc/en-us/articles/360022347072"}, {"label": "Wix", "url": "https://support.wix.com/en/article/blocking-ai-crawlers-from-your-site"}, {"label": "Cloudflare", "url": "https://developers.cloudflare.com/bots/additional-configurations/block-ai-bots/"}],
     "agentHelp": "The skill adds the crawler rules to your site’s robots.txt with you."},
    {"id": "human_review_right", "area": "decisions", "title": "Know your right to a human review",
     "minutes": 5, "impact": 1, "tier": 2, "checkMethod": "link",
     "links": [{"label": "EDPB: your rights", "url": "https://www.edpb.europa.eu/sme/be-compliant/respect-individuals-rights_en", "showIf": {"question": "country", "equals": "eu"}}, {"label": "ICO: decisions without people", "url": "https://ico.org.uk/for-the-public/your-rights-relating-to-decisions-being-made-about-you-without-human-involvement/", "showIf": {"question": "country", "equals": "uk"}}, {"label": "California privacy agency", "url": "https://cppa.ca.gov/", "showIf": {"question": "country", "equals": "us"}}]},
    {"id": "ask_explanation", "area": "decisions", "title": "Ask how a decision about you was made",
     "minutes": 30, "impact": 2, "tier": 2, "checkMethod": "self", "withOthers": true,
     "links": [{"label": "EDPB: your rights", "url": "https://www.edpb.europa.eu/sme/be-compliant/respect-individuals-rights_en", "showIf": {"question": "country", "equals": "eu"}}, {"label": "ICO: decisions without people", "url": "https://ico.org.uk/for-the-public/your-rights-relating-to-decisions-being-made-about-you-without-human-involvement/", "showIf": {"question": "country", "equals": "uk"}}],
     "agentHelp": "The skill drafts the request with you. You send it."},
    {"id": "fraud_reporting", "area": "response", "title": "Bookmark where to report fraud",
     "minutes": 2, "impact": 1, "tier": 2, "checkMethod": "link",
     "links": [{"label": "FTC", "url": "https://reportfraud.ftc.gov", "showIf": {"question": "country", "equals": "us"}}, {"label": "Europol links", "url": "https://www.europol.europa.eu/report-a-crime/report-cybercrime-online", "showIf": {"question": "country", "notEquals": "us"}}]},
    {"id": "deepfake_takedown", "area": "response", "title": "Know the deepfake takedown routes",
     "minutes": 3, "impact": 1, "tier": 3, "checkMethod": "link",
     "links": [{"label": "StopNCII", "url": "https://stopncii.org"}, {"label": "FTC Take It Down", "url": "https://takeitdown.ftc.gov", "showIf": {"question": "country", "equals": "us"}}]}
  ],

  "questions": [
    {"id": "panic_call", "label": "Panicked call", "text": "Someone close calls in a panic, in their voice, asking for money now. What happens?", "options": [
      {"value": "safe_word", "label": "I ask for our safe word", "done": ["safe_word", "callback_rule"]},
      {"value": "call_back", "label": "I hang up and call them back", "note": "Good instinct. A safe word makes it automatic.", "done": ["callback_rule"], "add": ["safe_word"]},
      {"value": "send_money", "label": "Honestly, I’d probably help", "note": "Most people would. Ten minutes fixes it.", "add": ["safe_word", "callback_rule", "brief_relatives"]}
    ]},
    {"id": "teens", "label": "Teenagers", "text": "Do teenagers in your life use AI chatbots or companion apps?", "hint": "ChatGPT, Snapchat’s My AI, Gemini, companion apps…", "options": [
      {"value": "mine", "label": "Yes, my own kids", "note": "72% of US teens have used an AI companion. Controls take fifteen minutes.", "add": ["teen_controls", "teen_talk"]},
      {"value": "family", "label": "Yes, others in the family", "add": ["teen_talk"]},
      {"value": "not_sure", "label": "Not sure", "note": "Worth asking. 72% of US teens have used one.", "add": ["teen_talk"]},
      {"value": "no", "label": "No teenagers around me"}
    ]},
    {"id": "bank_voice_id", "label": "Bank voice ID", "text": "Has your bank ever recognised you by voice?", "hint": "“My voice is my password” or similar.", "options": [
      {"value": "yes", "label": "Yes, I use voice ID", "note": "Cloned voices have passed these checks. One call turns it off.", "add": ["bank_voice_id_off"]},
      {"value": "no", "label": "No", "done": ["bank_voice_id_off"]},
      {"value": "not_sure", "label": "Not sure", "note": "Ask next time you call.", "add": ["bank_voice_id_off"]}
    ]},
    {"id": "public_media", "label": "Voice & face online", "text": "How much of your voice and face is online?", "options": [
      {"value": "lots", "label": "Videos or podcasts with my voice", "add": ["voice_inventory", "voice_audience", "voicemail_greeting", "likeness_monitoring", "face_search_optout", "deepfake_takedown"]},
      {"value": "photos", "label": "Mostly photos", "add": ["voicemail_greeting", "likeness_monitoring", "face_search_optout", "deepfake_takedown"]},
      {"value": "little", "label": "Barely anything", "note": "Your voicemail greeting may still be your voice.", "add": ["voicemail_greeting"]}
    ]},
    {"id": "ai_assistants", "label": "AI assistants", "text": "Which AI assistants do you use?", "hint": "Pick all that apply.", "multi": true,
     "effects": [{"if": {"question": "ai_assistants", "minCount": 1}, "add": ["assistant_memory"]}], "options": [
      {"value": "chatgpt", "label": "ChatGPT", "add": ["training_off_chatgpt"]},
      {"value": "claude", "label": "Claude", "add": ["training_off_claude"]},
      {"value": "gemini", "label": "Gemini", "add": ["activity_off_gemini"]},
      {"value": "copilot", "label": "Microsoft Copilot", "add": ["training_off_copilot"]},
      {"value": "meta", "label": "Meta AI", "add": ["meta_ai_settings"]},
      {"value": "none", "label": "None", "exclusive": true}
    ]},
    {"id": "ai_advice", "label": "Personal advice", "text": "Do you ask them for advice on personal things?", "hint": "Relationships, health, money, an argument with someone.",
     "showIf": {"question": "ai_assistants", "minCount": 1}, "options": [
      {"value": "often", "label": "Often", "note": "Chatbots back the user about 50% more often than people do. One instruction helps.", "add": ["push_back"]},
      {"value": "sometimes", "label": "Sometimes", "add": ["push_back"]},
      {"value": "no", "label": "No, mostly work or facts"}
    ]},
    {"id": "ai_agents", "label": "AI acting for you", "text": "Do any of them act for you?",
     "showIf": {"question": "ai_assistants", "minCount": 1}, "options": [
      {"value": "chat", "label": "No, I just chat"},
      {"value": "read", "label": "They read my email or files", "add": ["agent_inventory", "agent_revoke"]},
      {"value": "act", "label": "They browse, book or buy", "note": "The newest risk. Two settings matter most.", "add": ["agent_inventory", "agent_confirm", "agent_banking", "agent_revoke"]}
    ]},
    {"id": "platforms", "label": "Where you post", "text": "Where do you post?", "hint": "Pick all that apply.", "multi": true, "options": [
      {"value": "linkedin", "label": "LinkedIn", "add": ["training_off_linkedin"]},
      {"value": "meta", "label": "Facebook or Instagram", "add": ["meta_ai_settings"]},
      {"value": "x", "label": "X", "add": ["training_off_x"]},
      {"value": "youtube", "label": "My own YouTube channel", "add": ["youtube_likeness"]},
      {"value": "github", "label": "GitHub", "add": ["training_off_github"]},
      {"value": "art", "label": "Art or photo sites", "detail": "DeviantArt, ArtStation, Flickr…", "add": ["art_optout"]},
      {"value": "website", "label": "My own website or blog", "add": ["block_ai_crawlers"]},
      {"value": "none", "label": "None of these", "exclusive": true}
    ]},
    {"id": "decisions", "label": "Automated decisions", "text": "Has a company turned you down lately without a clear reason?", "hint": "A loan, an insurance claim, a job, an account.", "options": [
      {"value": "yes", "label": "Yes", "note": "You can ask how it was decided, and in some places for a person to look again.", "add": ["ask_explanation", "human_review_right"]},
      {"value": "applying", "label": "No, but I’m applying for something now", "add": ["human_review_right"]},
      {"value": "no", "label": "No"}
    ]},
    {"id": "country", "label": "Country", "text": "Where do you live?", "hint": "Rights and reporting routes differ.", "options": [
      {"value": "eu", "label": "EU", "add": ["fraud_reporting"]},
      {"value": "uk", "label": "UK", "add": ["fraud_reporting"]},
      {"value": "us", "label": "US", "add": ["fraud_reporting", "deepfake_takedown"]},
      {"value": "elsewhere", "label": "Elsewhere", "add": ["fraud_reporting"]}
    ]}
  ]
}
